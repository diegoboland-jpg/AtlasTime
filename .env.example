# Optional Open-Meteo customer endpoint for commercial use.
# The public non-commercial prototype uses the defaults when these are empty.
VITE_GEOCODING_API_URL=
VITE_GEOCODING_API_KEY=

# VITE_* values are public in the browser bundle. Never place a private server secret here.

# Optional v1.1 Google Calendar gateway. These values are read only by server/index.mjs.
# Never prefix private values with VITE_ and never commit real credentials.
ATLASTIME_APP_ORIGIN=http://localhost:4173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Defaults to the same-origin callback derived from ATLASTIME_APP_ORIGIN or Render's hostname.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4173/api/google-calendar/callback
# Generate a unique 32-byte base64url key for each environment.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional Microsoft/Outlook busy-free gateway. v1.7 uses it for recipient and organizer availability.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional. Defaults to the same-origin callback derived from ATLASTIME_APP_ORIGIN or Render's hostname.
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4173/api/outlook-calendar/callback
# Generate a separate unique 32-byte base64url key for Microsoft tokens.
MICROSOFT_TOKEN_ENCRYPTION_KEY=

# Secure availability links use ATLASTIME_APP_ORIGIN when constructing URLs.
# Production links require a public HTTPS origin and encrypted durable server storage.
# Generate a third, independent key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ATLASTIME_DATA_ENCRYPTION_KEY=
# Optional persistent-volume path. Relative paths resolve from the server folder.
ATLASTIME_DATA_FILE=../.data/availability-requests.json
# Keep backups on the same persistent volume, then copy them to separate protected storage.
ATLASTIME_BACKUP_DIR=../.data/backups

# Android Trusted Web Activity verification. Keep the package ID stable after Play publication.
ANDROID_APP_PACKAGE_ID=com.badie.kikroo
# Add the release certificate SHA-256 fingerprint only after creating and backing up the signing key.
ANDROID_SHA256_CERT_FINGERPRINTS=
