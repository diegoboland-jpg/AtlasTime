<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kikroo_widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kikroo · My group"
        android:textColor="@color/kikroo_ink"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:text="São Paulo  09:00    Madrid  14:00\nNew York  08:00    Manila  21:00"
        android:textColor="@color/kikroo_ink"
        android:textSize="13sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="−30        Now        +30"
        android:textColor="@color/kikroo_teal_dark"
        android:textStyle="bold" />
</LinearLayout>
